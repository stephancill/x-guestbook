{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tweet-miniapp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "guestbook.stupidtech.net", "custom_domain": true }],
  "vars": {
    "APP_ORIGIN": "https://guestbook.stupidtech.net",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tweet-guestbook",
      "database_id": "8e52b146-bbe4-454f-8822-914561101d0e",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },
}
