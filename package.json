{
  "name": "tweet-miniapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && wrangler dev",
    "build": "bun run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json && tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings src worker tests vite.config.ts",
    "format": "oxfmt .",
    "check": "bun run lint && bun run typecheck && oxfmt --check .",
    "deploy": "bun run build && wrangler deploy",
    "deploy:webview": "bun run build && wrangler deploy --config wrangler.webview.jsonc",
    "test": "vite build && bun test",
    "db:local": "wrangler d1 migrations apply tweet-guestbook --local",
    "db:remote": "wrangler d1 migrations apply tweet-guestbook --remote"
  },
  "dependencies": {
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/bun": "^1.4.2",
    "miniflare": "4",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.147.0"
  },
  "packageManager": "bun@1.3.14"
}
